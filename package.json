{
  "name": "open-digital-twin",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15.1 <23",
    "npm": ">=11.4.2 <12"
  },
  "packageManager": "npm@11.4.2",
  "scripts": {
    "dev": "vite",
    "dev:stack": "node scripts/codex/dev-stack.mjs",
    "demo:opcua-server": "tsx scripts/demo-opcua-server/main.ts",
    "build": "tsc -b && vite build",
    "build:sites": "npm run build && node scripts/sites/prepare-build.mjs",
    "build:gateway": "tsc -p tsconfig.gateway.json",
    "build:e2e": "tsc -b && vite build --mode test",
    "preview": "vite preview",
    "runtime:gateway": "node dist-gateway/middleware/runtime-gateway/main.js",
    "lint": "oxlint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:middleware": "vitest run middleware",
    "test:gateway": "vitest run middleware/runtime-gateway src/features/runtime-gateway/v4",
    "test:opcua-server-model": "vitest run middleware/runtime-gateway/opcua-nodeset-contract.test.ts middleware/runtime-gateway/opcua-robotics-projection.test.ts middleware/runtime-gateway/opcua-robotics-model.test.ts middleware/runtime-gateway/opcua-openweb-model.test.ts middleware/runtime-gateway/opcua-command-staging.test.ts middleware/runtime-gateway/browser-publisher-lease.test.ts middleware/runtime-gateway/browser-command-dispatch.test.ts middleware/runtime-gateway/integration-diagnostics.test.ts middleware/runtime-gateway/opcua-server-model.integration.test.ts src/core/runtime-protocol/integration-diagnostics-v1.test.ts src/features/runtime-gateway/v5/runtime-gateway-command-owner.test.ts",
    "test:demo:opcua": "vitest run scripts/demo-opcua-server",
    "test:connectivity-ui": "vitest run src/features/connectivity/v5 src/features/runtime-gateway/runtime-gateway-status-poller.test.ts src/features/runtime-gateway/v5/runtime-integration-diagnostics-client.test.ts src/features/ui/v4/StudioHeaderV4.test.tsx",
    "test:job-io": "vitest run src/core/project-v5 src/core/robot-runtime-v5 src/core/action-runtime-v5 src/core/runtime-protocol/v1.test.ts src/features/project/v5 src/features/signals/v5 src/features/runtime-gateway/v5 src/features/robot/v5 src/features/jobs/v5 src/features/actions/v5 src/features/scene/v5 middleware/runtime-gateway/opcua-client-read-plan.test.ts middleware/runtime-gateway/opcua-client-write-service.test.ts middleware/runtime-gateway/runtime-command-dedupe-registry.test.ts middleware/runtime-gateway/runtime-command-service.test.ts middleware/runtime-gateway/opcua-client-write.integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "benchmark:mechanism-tree-fk": "tsx scripts/performance/mechanism-tree-fk-benchmark.ts",
    "typecheck": "tsc -b --pretty false",
    "verify:guidance": "node scripts/codex/validate-guidance.mjs",
    "verify:codex": "node scripts/codex/verify-codex.mjs",
    "verify:p1": "npm run test:run -- src/core src/features/project/v4 middleware/runtime-gateway && npm run lint && npm run build:gateway && node dist-gateway/middleware/runtime-gateway/main.js --check-config && npm run build",
    "verify:v5-core": "npm run test:run -- src/core/project-v5 src/features/project/v5 && npm run lint && npm run build:gateway && npm run build",
    "cad:validate": "tsx scripts/cad/validate-robot-assets.ts",
    "deploy:validate": "node scripts/deployment/validate-deployment.mjs",
    "deploy:build": "docker compose build",
    "deploy:smoke": "node scripts/deployment/smoke-deployment.mjs",
    "deploy:smoke:opcua": "node scripts/deployment/smoke-deployment.mjs --opcua",
    "test:e2e:v4": "playwright test tests/project-v4-multi-robot.spec.ts",
    "test:e2e:viewport": "playwright test tests/viewport-context-viewcube.spec.ts",
    "test:e2e:layout": "playwright test tests/docked-ribbon-layout.spec.ts",
    "test:e2e:v5": "playwright test tests/project-v5-browser-cutover.spec.ts tests/opcua-settings-monitor.spec.ts tests/mechanism-tree-viewport-fixtures.spec.ts",
    "test:e2e:v6": "playwright test tests/ui-v6-shell.spec.ts tests/ui-v6-scene.spec.ts tests/ui-v6-jobs.spec.ts tests/ui-v6-connectivity.spec.ts tests/ui-v6-accessibility.spec.ts tests/mechanism-tree-viewport-fixtures.spec.ts",
    "test:e2e": "npm run test:e2e:v6",
    "verify": "npm run lint && npm run test:run && npm run cad:validate && npm run deploy:validate && npm run build:gateway && node dist-gateway/middleware/runtime-gateway/main.js --check-config && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.24.0",
    "node-opcua": "2.175.0",
    "node-opcua-nodesets": "2.174.0",
    "occt-import-js": "0.0.23",
    "pretendard": "1.3.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "saxes": "6.0.0",
    "three": "0.185.1",
    "ws": "8.21.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@types/ws": "8.5.14",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "oxlint": "1.73.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
